{
  "mcpServers": {
    "quota-orb": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-m",
        "quota_orb.mcp_server",
        "--transport",
        "stdio"
      ],
      "env": {
        "QUOTA_ORB_SNAPSHOT_FILE": "<absolute-path-to-snapshot.json>"
      }
    }
  }
}
